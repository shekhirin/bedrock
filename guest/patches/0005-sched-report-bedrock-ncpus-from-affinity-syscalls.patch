From: Bedrock <bedrock@example.com>
Subject: [PATCH 5/5] sched: report bedrock_ncpus=N CPUs from the affinity syscalls

Bedrock guests have a single vCPU. Multi-threaded workloads run fine --
the scheduler time-slices every thread on that vCPU deterministically --
but runtimes size their thread pools from the CPU count reported by
sched_getaffinity(): Rust's available_parallelism() (tokio, rayon, reth),
num_cpus, Go's GOMAXPROCS, glibc's CPU_COUNT/nproc. With one CPU they
collapse to a single worker, and some code switches to non-production
paths (reth only runs its state-root task with >= 5 CPUs).

Add a bedrock_ncpus=N boot parameter. When set, sched_getaffinity()
reports CPUs 0..N-1 for any existing task, and sched_setaffinity()
succeeds without changing anything (there is only one CPU to run on).
Unlike an LD_PRELOAD shim this covers static, musl and Go binaries.
The real cpumasks, sysfs and /proc are untouched, so the kernel and
anything reading /sys/devices/system/cpu/{online,possible} (libbpf,
glibc sysconf) still see the real topology. Unset or 0 = stock behavior.

Signed-off-by: Bedrock <bedrock@example.com>
---
 kernel/sched/syscalls.c | 37 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/kernel/sched/syscalls.c b/kernel/sched/syscalls.c
index 77ae87f..3b6caff 100644
--- a/kernel/sched/syscalls.c
+++ b/kernel/sched/syscalls.c
@@ -1262,6 +1262,28 @@ static int get_user_cpu_mask(unsigned long __user *user_mask_ptr, unsigned len,
 	return copy_from_user(new_mask, user_mask_ptr, len) ? -EFAULT : 0;
 }
 
+/*
+ * Bedrock: bedrock_ncpus=N on the kernel command line makes the affinity
+ * syscalls report CPUs 0..N-1 to userspace, so runtimes that size thread
+ * pools from the CPU count (Rust's available_parallelism -> tokio, rayon,
+ * reth; num_cpus; Go's GOMAXPROCS; glibc's CPU_COUNT) behave as on an N-core
+ * machine, while bedrock still runs every thread on its single vCPU.
+ * Affinity changes are accepted and ignored: there is only one CPU to run on.
+ * Unset or 0 = stock behavior.
+ */
+#define BEDROCK_MAX_NCPUS	1024
+static unsigned int bedrock_ncpus;
+static DECLARE_BITMAP(bedrock_cpus, BEDROCK_MAX_NCPUS);
+
+static int __init bedrock_ncpus_setup(char *str)
+{
+	if (kstrtouint(str, 0, &bedrock_ncpus) || bedrock_ncpus > BEDROCK_MAX_NCPUS)
+		bedrock_ncpus = 0;
+	bitmap_set(bedrock_cpus, 0, bedrock_ncpus);
+	return 1;
+}
+__setup("bedrock_ncpus=", bedrock_ncpus_setup);
+
 /**
  * sys_sched_setaffinity - set the CPU affinity of a process
  * @pid: pid of the process
@@ -1276,6 +1298,11 @@ SYSCALL_DEFINE3(sched_setaffinity, pid_t, pid, unsigned int, len,
 	cpumask_var_t new_mask;
 	int retval;
 
+	if (bedrock_ncpus) {
+		guard(rcu)();
+		return find_process_by_pid(pid) ? 0 : -ESRCH;
+	}
+
 	if (!alloc_cpumask_var(&new_mask, GFP_KERNEL))
 		return -ENOMEM;
 
@@ -1330,7 +1357,15 @@ SYSCALL_DEFINE3(sched_getaffinity, pid_t, pid, unsigned int, len,
 		return -ENOMEM;
 
 	ret = sched_getaffinity(pid, mask);
-	if (ret == 0) {
+	if (ret == 0 && bedrock_ncpus) {
+		unsigned int n = min(bedrock_ncpus, len * BITS_PER_BYTE);
+		unsigned int retlen = BITS_TO_LONGS(n) * sizeof(unsigned long);
+
+		if (copy_to_user(user_mask_ptr, bedrock_cpus, retlen))
+			ret = -EFAULT;
+		else
+			ret = retlen;
+	} else if (ret == 0) {
 		unsigned int retlen = min(len, cpumask_size());
 
 		if (copy_to_user(user_mask_ptr, cpumask_bits(mask), retlen))
